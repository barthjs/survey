{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "barthjs/survey",
    "type": "project",
    "description": "Survey creation tool",
    "homepage": "https://github.com/barthjs/survey",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "bacon/bacon-qr-code": "^3.1.1",
        "jenssegers/agent": "^2.6.4",
        "laravel/framework": "^13.37.0",
        "laravel/socialite": "^5.31.0",
        "livewire/livewire": "^4.4.7",
        "pragmarx/google2fa": "^9.1",
        "robsontenorio/mary": "^2.9.10",
        "socialiteproviders/authelia": "^4.0",
        "socialiteproviders/authentik": "^5.3",
        "socialiteproviders/gitea": "^4.1",
        "socialiteproviders/keycloak": "^5.3"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6.2",
        "fakerphp/faker": "^1.24.1",
        "fruitcake/laravel-debugbar": "^4.4.4",
        "larastan/larastan": "^3.13.0",
        "laravel/boost": "^2.10.3",
        "laravel/pint": "^1.32.1",
        "laravel/tinker": "^3.0.2",
        "laravel/pao": "^1.1.5",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3.2",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-livewire": "^5.0.0",
        "pestphp/pest-plugin-phpstan": "^5.2.2",
        "pestphp/pest-plugin-rector": "^5.0.6",
        "pestphp/pest-plugin-type-coverage": "^5.0.3",
        "rector/rector": "^2.7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup-dev": [
            "composer install",
            "npm install --ignore-scripts",
            "npm run build",
            "@publish-assets",
            "@php -r \"file_exists('.env') || copy('.env.development', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate",
            "@php artisan db:seed",
            "@php artisan storage:link"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@publish-assets",
            "@php artisan clear",
            "@update:requirements"
        ],
        "publish-assets": [
            "@php artisan livewire:publish --assets"
        ],
        "update:requirements": [
            "composer bump"
        ],
        "lint": [
            "rector",
            "pint --parallel",
            "npm run lint"
        ],
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "npm run test:lint"
        ],
        "test:type-coverage": "pest --type-coverage --compact --min=100",
        "test:types": [
            "phpstan",
            "npm run test:types"
        ],
        "test:unit": "pest --parallel --coverage",
        "test": [
            "@php artisan config:clear --ansi",
            "@test:lint",
            "@test:type-coverage",
            "@test:types",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
